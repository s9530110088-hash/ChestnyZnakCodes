// 1С 8.3/8.5 — форма внешней обработки "Экспорт КМ Честного ЗНАК"
// Для Бухгалтерии 3.0.x.
// Экспортирует эмитированные КМ из РС ПулКодовМаркировкиСУЗ.
// ПолныйКодМаркировки декодируется из Base64.
// Формат CSV: "Полный КМ";"GTIN";"Номенклатура"
// Обработка ничего не удаляет и не изменяет в регистре.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если НЕ ЗначениеЗаполнено(Объект.КоличествоКодов) Тогда
        Объект.КоличествоКодов = 180;
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(Объект.ТолькоНепечатанные) Тогда
        Объект.ТолькоНепечатанные = Истина;
    КонецЕсли;

    Объект.Статус = "Готово к выгрузке.";

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталог(Команда)

    Диалог = Новый ДиалогВыбораФайла;
    Диалог.ВыборКаталога = Истина;
    Диалог.МножественныйВыбор = Ложь;
    Диалог.Заголовок = "Выберите папку для сохранения CSV";

    Если Диалог.Выбрать() Тогда
        Объект.Каталог = Диалог.Каталог;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Экспорт(Команда)

    Если НЕ ЗначениеЗаполнено(Объект.Каталог) Тогда
        Сообщить("Сначала выберите папку для сохранения.");
        Возврат;
    КонецЕсли;

    Если Объект.КоличествоКодов < 0 Тогда
        Сообщить("Количество кодов не может быть отрицательным.");
        Возврат;
    КонецЕсли;

    Объект.Статус = "Выгружаю коды из ПулКодовМаркировкиСУЗ...";

    Результат = ЭкспортНаСервере(
        Объект.Каталог,
        Объект.КоличествоКодов,
        Объект.ЗаказНаЭмиссию,
        Объект.ТолькоНепечатанные);

    Объект.Статус = Результат;
    Сообщить(Результат);

КонецПроцедуры

&НаСервере
Функция ЭкспортНаСервере(Каталог, КоличествоКодов, ЗаказНаЭмиссию, ТолькоНепечатанные)

    Если НЕ ЗначениеЗаполнено(Каталог) Тогда
        Возврат "Не выбрана папка.";
    КонецЕсли;

    Путь = Каталог +
        ?(Прав(Каталог, 1) = "\", "", "\") +
        "codesOrder_" +
        Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd_HH-mm-ss") +
        ".csv";

    Запись = Новый ЗаписьТекста(
        Путь,
        КодировкаТекста.UTF8,
        Ложь,
        Символы.ПС);

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Пул.ПолныйКодМаркировки КАК ПолныйКМ,
    |   Пул.КодМаркировки КАК КодМаркировки,
    |   Пул.GTIN КАК GTIN,
    |   Пул.Номенклатура КАК Номенклатура,
    |   Пул.ЗаказНаЭмиссию КАК ЗаказНаЭмиссию,
    |   Пул.ДатаПечатиУниверсальная КАК ДатаПечати
    |ИЗ
    |   РегистрСведений.ПулКодовМаркировкиСУЗ КАК Пул
    |ГДЕ
    |   Пул.ПолныйКодМаркировки <> &ПустойКод";

    Если ЗначениеЗаполнено(ЗаказНаЭмиссию) Тогда
        Запрос.Текст = Запрос.Текст +
        Символы.ПС +
        "|   И Пул.ЗаказНаЭмиссию = &ЗаказНаЭмиссию";
    КонецЕсли;

    Если ТолькоНепечатанные Тогда
        Запрос.Текст = Запрос.Текст +
        Символы.ПС +
        "|   И Пул.ДатаПечатиУниверсальная = ДАТАВРЕМЯ(1, 1, 1)";
    КонецЕсли;

    Запрос.Текст = Запрос.Текст +
        Символы.ПС +
        "|УПОРЯДОЧИТЬ ПО Пул.КодМаркировки";

    Запрос.УстановитьПараметр("ПустойКод", "");

    Если ЗначениеЗаполнено(ЗаказНаЭмиссию) Тогда
        Запрос.УстановитьПараметр("ЗаказНаЭмиссию", ЗаказНаЭмиссию);
    КонецЕсли;

    Выборка = Запрос.Выполнить().Выбрать();

    Счетчик = 0;

    Пока Выборка.Следующий() Цикл

        Если КоличествоКодов > 0 И Счетчик >= КоличествоКодов Тогда
            Прервать;
        КонецЕсли;

        КМ = РаскодироватьКМ(Выборка.ПолныйКМ);

        Если ПустаяСтрока(КМ) Тогда
            Продолжить;
        КонецЕсли;

        КМ = ПодготовитьКМДляСУЛ(КМ);

        GTIN = "";
        Если ЗначениеЗаполнено(Выборка.GTIN) Тогда
            GTIN = Строка(Выборка.GTIN);
        ИначеЕсли СтрДлина(КМ) >= 16 И Лев(КМ, 2) = "01" Тогда
            GTIN = Сред(КМ, 3, 14);
        КонецЕсли;

        Наименование = "";
        Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
            Наименование = Строка(Выборка.Номенклатура);
        КонецЕсли;

        Запись.ЗаписатьСтроку(
            CSVПоле(КМ) + ";" +
            CSVПоле(GTIN) + ";" +
            CSVПоле(Наименование));

        Счетчик = Счетчик + 1;

    КонецЦикла;

    Запись.Закрыть();

    Если Счетчик = 0 Тогда
        Возврат "Коды не найдены. Проверьте заказ и фильтр 'Только непечатанные'.";
    КонецЕсли;

    Возврат "Готово. Выгружено кодов: " + Счетчик + ". Файл: " + Путь;

КонецФункции

&НаСервере
Функция РаскодироватьКМ(Знач ЗначениеКМ)

    Если НЕ ЗначениеЗаполнено(ЗначениеКМ) Тогда
        Возврат "";
    КонецЕсли;

    ИсходнаяСтрока = Строка(ЗначениеКМ);

    Попытка
        ДвоичныеДанные = Base64Значение(ИсходнаяСтрока);
        Чтение = Новый ЧтениеДанных(ДвоичныеДанные);
        Результат = Чтение.ПрочитатьСимволы();
        Чтение.Закрыть();

        Если СтрНачинаетсяС(Результат, "01") Тогда
            Возврат Результат;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат ИсходнаяСтрока;

КонецФункции

&НаСервере
Функция ПодготовитьКМДляСУЛ(Знач КМ)

    КМ = СтрЗаменить(КМ, Символ(29), " ");
    КМ = СтрЗаменить(КМ, Символы.ПС, " ");
    КМ = СтрЗаменить(КМ, Символы.ВК, " ");

    Пока СтрНайти(КМ, "  ") > 0 Цикл
        КМ = СтрЗаменить(КМ, "  ", " ");
    КонецЦикла;

    Возврат СокрЛП(КМ);

КонецФункции

&НаСервере
Функция CSVПоле(Значение)

    Если НЕ ЗначениеЗаполнено(Значение) Тогда
        Возврат """" + """"";
    КонецЕсли;

    Т = Строка(Значение);
    Т = СтрЗаменить(Т, """""", """"""""");
    Т = СтрЗаменить(Т, Символы.ПС, " ");
    Т = СтрЗаменить(Т, Символы.ВК, " ");

    Возврат """" + Т + """";

КонецФункции

// Реквизиты формы:
// КоличествоКодов — Число, 0 = все.
// Каталог — Строка.
// ЗаказНаЭмиссию — ссылка на документ "Заказ на эмиссию кодов маркировки СУЗ".
// ТолькоНепечатанные — Булево, по умолчанию Истина.
// Статус — Строка.
// Команды: ВыбратьКаталог, Экспорт.
//
// Для запуска без привязки к заказу ЗаказНаЭмиссию можно оставить пустым.
// Для безопасной выгрузки конкретного заказа рекомендуется указать его.
