// 1С 8.3 — модуль формы внешней обработки "Экспорт кодов Честного ЗНАК"
// Требуется создать внешнюю обработку (.epf) с формой.
// Элементы формы:
//  КоличествоКодов (Число), Каталог (Строка), КнопкаВыбратьКаталог,
//  КнопкаЭкспорт, Результат (Строка/Поле надписи).
//
// ВАЖНО: названия регистра и реквизитов ниже нужно сверить с вашей конфигурацией.

Перем ИмяРегистра, ПолеКМ, ПолеGTIN, ПолеНоменклатура;

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ИмяРегистра = "ПулКодовМаркировкиСУЗ";
    ПолеКМ = "ПолныйКодМаркировки";
    ПолеGTIN = "GTIN";
    ПолеНоменклатура = "Номенклатура";
    
    Если НЕ ЗначениеЗаполнено(Объект.КоличествоКодов) Тогда
        Объект.КоличествоКодов = 180;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталог(Команда)
    Диалог = Новый ДиалогВыбораФайла;
    Диалог.ВыборКаталога = Истина;
    Диалог.МножественныйВыбор = Ложь;
    Диалог.Заголовок = "Выберите папку для сохранения CSV";
    
    Если Диалог.Выбрать() Тогда
        Объект.Каталог = Диалог.Каталог;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Экспорт(Команда)
    Если НЕ ЗначениеЗаполнено(Объект.Каталог) Тогда
        Сообщить("Сначала выберите папку для сохранения.");
        Возврат;
    КонецЕсли;
    
    Если Объект.КоличествоКодов < 0 Тогда
        Сообщить("Количество кодов не может быть отрицательным.");
        Возврат;
    КонецЕсли;
    
    Результат = ЭкспортНаСервере(Объект.Каталог, Объект.КоличествоКодов);
    Сообщить(Результат);
КонецПроцедуры

&НаСервере
Функция ЭкспортНаСервере(Каталог, КоличествоКодов)
    
    Если НЕ ЗначениеЗаполнено(Каталог) Тогда
        Возврат "Не выбрана папка.";
    КонецЕсли;
    
    Путь = Каталог + ?(Прав(Каталог, 1) = "\", "", "\") +
        "codesOrder_" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd_HH-mm-ss") + ".csv";
    
    Запись = Новый ЗаписьТекста(
        Путь,
        КодировкаТекста.UTF8,
        Ложь,
        Символы.ПС);
    
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    | Пул." + ПолеКМ + " КАК ПолныйКМ,
    | Пул." + ПолеGTIN + " КАК GTIN,
    | Пул." + ПолеНоменклатура + " КАК Номенклатура
    |ИЗ
    | РегистрСведений." + ИмяРегистра + " КАК Пул
    |ГДЕ
    | Пул." + ПолеКМ + " <> &ПустойКод";
    
    Запрос.УстановитьПараметр("ПустойКод", "");
    Выборка = Запрос.Выполнить().Выбрать();
    
    Счетчик = 0;
    
    Пока Выборка.Следующий() Цикл
        
        Если КоличествоКодов > 0 И Счетчик >= КоличествоКодов Тогда
            Прервать;
        КонецЕсли;
        
        КМ = ПодготовитьКМ(Выборка.ПолныйКМ);
        Если ПустаяСтрока(КМ) Тогда
            Продолжить;
        КонецЕсли;
        
        GTIN = ?(ЗначениеЗаполнено(Выборка.GTIN), Строка(Выборка.GTIN), "");
        Наименование = ?(ЗначениеЗаполнено(Выборка.Номенклатура), Строка(Выборка.Номенклатура), "");
        
        Запись.ЗаписатьСтроку(
            CSVПоле(КМ) + ";" +
            CSVПоле(GTIN) + ";" +
            CSVПоле(Наименование));
        
        Счетчик = Счетчик + 1;
    КонецЦикла;
    
    Запись.Закрыть();
    
    Возврат "Готово. Сохранено кодов: " + Счетчик + ". Файл: " + Путь;
КонецФункции

&НаСервере
Функция ПодготовитьКМ(Знач КМ)
    Если НЕ ЗначениеЗаполнено(КМ) Тогда
        Возврат "";
    КонецЕсли;
    
    КМ = Строка(КМ);
    КМ = СтрЗаменить(КМ, Символ(29), " ");
    КМ = СтрЗаменить(КМ, Символы.ПС, " ");
    КМ = СтрЗаменить(КМ, Символы.ВК, " ");
    
    Пока СтрНайти(КМ, "  ") > 0 Цикл
        КМ = СтрЗаменить(КМ, "  ", " ");
    КонецЦикла;
    
    Возврат СокрЛП(КМ);
КонецФункции

&НаСервере
Функция CSVПоле(Значение)
    Если НЕ ЗначениеЗаполнено(Значение) Тогда
        Возврат """" + """"; 
    КонецЕсли;
    
    Т = Строка(Значение);
    Т = СтрЗаменить(Т, """", """""");
    Т = СтрЗаменить(Т, Символы.ПС, " ");
    Т = СтрЗаменить(Т, Символы.ВК, " ");
    
    Возврат """" + Т + """";
КонецФункции
