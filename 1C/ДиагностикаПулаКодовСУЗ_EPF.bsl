#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ДиагностикаПулаКодов();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДиагностикаПулаКодов()

    Сообщить("=== ДИАГНОСТИКА ПУЛА КОДОВ СУЗ ===");
    Сообщить("Версия конфигурации: " + Метаданные.Версия);

    Найдено = Ложь;

    Для Каждого Регистр Из Метаданные.РегистрыСведений Цикл

        Имя = Регистр.Имя;
        Синоним = Регистр.Синоним;
        СтрокаПоиска = НРег(Имя + " " + Синоним);

        Если СтрНайти(СтрокаПоиска, "пул") > 0
            ИЛИ СтрНайти(СтрокаПоиска, "суз") > 0
            ИЛИ СтрНайти(СтрокаПоиска, "кодмаркиров") > 0
            ИЛИ СтрНайти(СтрокаПоиска, "маркиров") > 0 Тогда

            Найдено = Истина;

            Сообщить("");
            Сообщить("РЕГИСТР: " + Имя);
            Сообщить("Синоним: " + Синоним);

            Сообщить("-- Измерения --");
            Для Каждого Поле Из Регистр.Измерения Цикл
                Сообщить(Поле.Имя + " | " + Поле.Синоним);
            КонецЦикла;

            Сообщить("-- Ресурсы --");
            Для Каждого Поле Из Регистр.Ресурсы Цикл
                Сообщить(Поле.Имя + " | " + Поле.Синоним);
            КонецЦикла;

            Сообщить("-- Реквизиты --");
            Для Каждого Поле Из Регистр.Реквизиты Цикл
                Сообщить(Поле.Имя + " | " + Поле.Синоним);
            КонецЦикла;

        КонецЕсли;

    КонецЦикла;

    Если НЕ Найдено Тогда
        Сообщить("");
        Сообщить("Подходящий регистр не найден.");
        Сообщить("=== ВСЕ РЕГИСТРЫ СВЕДЕНИЙ ===");

        Для Каждого Регистр Из Метаданные.РегистрыСведений Цикл
            Сообщить(Регистр.Имя + " | " + Регистр.Синоним);
        КонецЦикла;
    КонецЕсли;

    Сообщить("");
    Сообщить("=== КОНЕЦ ДИАГНОСТИКИ ===");

КонецПроцедуры

#КонецОбласти
