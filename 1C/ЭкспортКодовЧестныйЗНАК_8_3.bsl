// 1С 8.3/8.5 — экспорт эмитированных КМ из РС ПулКодовМаркировкиСУЗ
// Для Бухгалтерии 3.0.x.
// Важно: ПолныйКодМаркировки в пуле хранится в Base64.
// Обработка декодирует его и заменяет GS (ASCII 29) на пробел для CSV СУЛ.
// Обработка ТОЛЬКО ЧИТАЕТ данные 1С: ничего в пуле не меняет и не помечает как напечатанное.

Перем ИмяРегистра;

Процедура Инициализация() Экспорт
    ИмяРегистра = "ПулКодовМаркировкиСУЗ";
КонецПроцедуры

Функция РаскодироватьПолныйКМ(Знач ЗначениеКМ) Экспорт

    Если НЕ ЗначениеЗаполнено(ЗначениеКМ) Тогда
        Возврат "";
    КонецЕсли;

    ИсходнаяСтрока = Строка(ЗначениеКМ);

    // В типовом пуле 1С ПолныйКодМаркировки хранится в Base64.
    Попытка
        ДвоичныеДанные = Base64Значение(ИсходнаяСтрока);
        Чтение = Новый ЧтениеДанных(ДвоичныеДанные);
        РаскодированныйКМ = Чтение.ПрочитатьСимволы();
        Чтение.Закрыть();

        // Проверяем, что это действительно КМ, а не случайное Base64-значение.
        Если СтрНачинаетсяС(РаскодированныйКМ, "01") Тогда
            Возврат РаскодированныйКМ;
        КонецЕсли;
    Исключение
        // Ниже будет запасной вариант.
    КонецПопытки;

    // Запасной вариант для баз/версий, где поле уже хранится текстом.
    Возврат ИсходнаяСтрока;

КонецФункции

Функция ПодготовитьКМДляСУЛ(Знач ЗначениеКМ) Экспорт

    КМ = РаскодироватьПолныйКМ(ЗначениеКМ);

    Если ПустаяСтрока(КМ) Тогда
        Возврат "";
    КонецЕсли;

    // GS/FNC1 (ASCII 29) в CSV СУЛ представляем пробелом.
    КМ = СтрЗаменить(КМ, Символ(29), " ");
    КМ = СтрЗаменить(КМ, Символы.ПС, " ");
    КМ = СтрЗаменить(КМ, Символы.ВК, " ");

    Пока СтрНайти(КМ, "  ") > 0 Цикл
        КМ = СтрЗаменить(КМ, "  ", " ");
    КонецЦикла;

    Возврат СокрЛП(КМ);

КонецФункции

Функция ПолучитьGTIN(Знач ЗначениеGTIN, Знач КМ) Экспорт

    Если ЗначениеЗаполнено(ЗначениеGTIN) Тогда
        Возврат Строка(ЗначениеGTIN);
    КонецЕсли;

    // AI 01 = GTIN из 14 цифр. После "01" идут 14 цифр.
    Если СтрДлина(КМ) >= 16 И Лев(КМ, 2) = "01" Тогда
        Возврат Сред(КМ, 3, 14);
    КонецЕсли;

    Возврат "";

КонецФункции

Функция CSVПоле(Значение) Экспорт

    Если НЕ ЗначениеЗаполнено(Значение) Тогда
        Возврат """" + """"";
    КонецЕсли;

    Т = Строка(Значение);
    Т = СтрЗаменить(Т, """""", """"""""");
    Т = СтрЗаменить(Т, Символы.ПС, " ");
    Т = СтрЗаменить(Т, Символы.ВК, " ");

    Возврат """" + Т + """";

КонецФункции

Функция Экспортировать(ПутьКФайлу, КоличествоКодов = 0, ЗаказНаЭмиссию = Неопределено, ТолькоНепечатанные = Истина) Экспорт

    Инициализация();

    Запись = Новый ЗаписьТекста(
        ПутьКФайлу,
        КодировкаТекста.UTF8,
        Ложь,
        Символы.ПС);

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1000000
    |   Пул.ПолныйКодМаркировки КАК ПолныйКМ,
    |   Пул.КодМаркировки КАК КодМаркировки,
    |   Пул.GTIN КАК GTIN,
    |   Пул.Номенклатура КАК Номенклатура,
    |   Пул.ЗаказНаЭмиссию КАК ЗаказНаЭмиссию,
    |   Пул.ДатаПечатиУниверсальная КАК ДатаПечати
    |ИЗ
    |   РегистрСведений.ПулКодовМаркировкиСУЗ КАК Пул
    |ГДЕ
    |   Пул.ПолныйКодМаркировки <> &ПустойКод";

    Если ЗначениеЗаполнено(ЗаказНаЭмиссию) Тогда
        Запрос.Текст = Запрос.Текст +
        Символы.ПС +
        "|   И Пул.ЗаказНаЭмиссию = &ЗаказНаЭмиссию";
    КонецЕсли;

    Если ТолькоНепечатанные Тогда
        Запрос.Текст = Запрос.Текст +
        Символы.ПС +
        "|   И Пул.ДатаПечатиУниверсальная = ДАТАВРЕМЯ(1, 1, 1)";
    КонецЕсли;

    Запрос.Текст = Запрос.Текст +
        Символы.ПС +
        "|УПОРЯДОЧИТЬ ПО Пул.КодМаркировки";

    Запрос.УстановитьПараметр("ПустойКод", "");

    Если ЗначениеЗаполнено(ЗаказНаЭмиссию) Тогда
        Запрос.УстановитьПараметр("ЗаказНаЭмиссию", ЗаказНаЭмиссию);
    КонецЕсли;

    Выборка = Запрос.Выполнить().Выбрать();
    Счетчик = 0;

    Пока Выборка.Следующий() Цикл

        Если КоличествоКодов > 0 И Счетчик >= КоличествоКодов Тогда
            Прервать;
        КонецЕсли;

        КМ = ПодготовитьКМДляСУЛ(Выборка.ПолныйКМ);

        Если ПустаяСтрока(КМ) Тогда
            Продолжить;
        КонецЕсли;

        GTIN = ПолучитьGTIN(Выборка.GTIN, КМ);

        Наименование = "";
        Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
            Наименование = Строка(Выборка.Номенклатура);
        КонецЕсли;

        Запись.ЗаписатьСтроку(
            CSVПоле(KМ) + ";" +
            CSVПоле(GTIN) + ";" +
            CSVПоле(Наименование));

        Счетчик = Счетчик + 1;

    КонецЦикла;

    Запись.Закрыть();

    Возврат Счетчик;

КонецФункции

Функция ИмяCSV() Экспорт

    Возврат "codesOrder_" +
        Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd_HH-mm-ss") +
        ".csv";

КонецФункции

// Пример:
// Количество = Экспортировать("C:\\Temp\\codesOrder.csv", 180, СсылкаНаЗаказ, Истина);
//
// Количество = 0 — все коды.
// ТолькоНепечатанные = Истина — только коды, еще не отмеченные 1С как напечатанные.
// Обработка не удаляет коды и не меняет ДатуПечати.
