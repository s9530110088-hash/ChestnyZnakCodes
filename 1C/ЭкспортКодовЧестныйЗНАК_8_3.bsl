// Внешняя обработка 1С 8.3 — экспорт заказанных кодов Честного ЗНАК
// CSV: "Полный КМ";"GTIN";"Наименование"
// ASCII 29 (GS) в полном КМ заменяется пробелом.
// Обработка только читает данные и не изменяет регистр.

Перем ИмяРегистра, ПолеКМ, ПолеGTIN, ПолеНоменклатура;

Процедура Инициализация() Экспорт
    ИмяРегистра = "ПулКодовМаркировкиСУЗ";
    ПолеКМ = "ПолныйКодМаркировки";
    ПолеGTIN = "GTIN";
    ПолеНоменклатура = "Номенклатура";
КонецПроцедуры

Функция ПодготовитьКМ(Знач КМ) Экспорт
    Если НЕ ЗначениеЗаполнено(КМ) Тогда Возврат ""; КонецЕсли;
    КМ = Строка(КМ);
    КМ = СтрЗаменить(КМ, Символ(29), " ");
    КМ = СтрЗаменить(КМ, Символы.ПС, " ");
    КМ = СтрЗаменить(КМ, Символы.ВК, " ");
    Пока СтрНайти(КМ, "  ") > 0 Цикл
        КМ = СтрЗаменить(КМ, "  ", " ");
    КонецЦикла;
    Возврат СокрЛП(КМ);
КонецФункции

Функция CSVПоле(Значение) Экспорт
    Если НЕ ЗначениеЗаполнено(Значение) Тогда Возврат """" + """"; КонецЕсли;
    Т = Строка(Значение);
    Т = СтрЗаменить(Т, """", """""");
    Т = СтрЗаменить(Т, Символы.ПС, " ");
    Т = СтрЗаменить(Т, Символы.ВК, " ");
    Возврат """" + Т + """";
КонецФункции

Функция Экспортировать(ПутьКФайлу, КоличествоКодов = 0) Экспорт

    Инициализация();

    Запись = Новый ЗаписьТекста(
        ПутьКФайлу,
        КодировкаТекста.UTF8,
        Ложь,
        Символы.ПС);

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    | Пул." + ПолеКМ + " КАК ПолныйКМ,
    | Пул." + ПолеGTIN + " КАК GTIN,
    | Пул." + ПолеНоменклатура + " КАК Номенклатура
    |ИЗ
    | РегистрСведений." + ИмяРегистра + " КАК Пул
    |ГДЕ
    | Пул." + ПолеКМ + " <> &ПустойКод";

    Запрос.УстановитьПараметр("ПустойКод", "");

    Выборка = Запрос.Выполнить().Выбрать();
    Счетчик = 0;

    Пока Выборка.Следующий() Цикл

        Если КоличествоКодов > 0 И Счетчик >= КоличествоКодов Тогда
            Прервать;
        КонецЕсли;

        КМ = ПодготовитьКМ(Выборка.ПолныйКМ);
        Если ПустаяСтрока(КМ) Тогда Продолжить; КонецЕсли;

        GTIN = "";
        Если ЗначениеЗаполнено(Выборка.GTIN) Тогда
            GTIN = Строка(Выборка.GTIN);
        КонецЕсли;

        Наименование = "";
        Если ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
            Наименование = Строка(Выборка.Номенклатура);
        КонецЕсли;

        Запись.ЗаписатьСтроку(
            CSVПоле(КМ) + ";" +
            CSVПоле(GTIN) + ";" +
            CSVПоле(Наименование));

        Счетчик = Счетчик + 1;

    КонецЦикла;

    Запись.Закрыть();

    Возврат Счетчик;

КонецФункции

Функция ИмяCSV() Экспорт
    Возврат "codesOrder_" +
        Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd_HH-mm-ss") +
        ".csv";
КонецФункции

