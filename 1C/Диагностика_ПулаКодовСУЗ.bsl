// Диагностика метаданных регистра сведений ПулКодовМаркировкиСУЗ
// Запуск: вставить код в модуль внешней обработки/обработки.
// Цель: без Конфигуратора определить точное имя регистра и его поля.

Процедура ВыполнитьДиагностику() Экспорт

    Сообщить("=== ДИАГНОСТИКА ПУЛА КОДОВ СУЗ ===");

    Найдено = Ложь;

    Для Каждого РегИзМетаданных Из Метаданные.РегистрыСведений Цикл

        Имя = РегИзМетаданных.Имя;
        Представление = РегИзМетаданных.Синоним;

        // Ищем наиболее вероятные регистры по имени/синониму.
        ТекстПоиска = НРег(Имя + " " + Представление);

        Если СтрНайти(ТекстПоиска, "пул") > 0
            ИЛИ СтрНайти(ТекстПоиска, "суз") > 0
            ИЛИ СтрНайти(ТекстПоиска, "кодмаркиров") > 0
            ИЛИ СтрНайти(ТекстПоиска, "маркиров") > 0 Тогда

            Найдено = Истина;

            Сообщить("");
            Сообщить("РЕГИСТР: " + Имя);
            Сообщить("Синоним: " + Представление);

            Сообщить("  Измерения:");
            Для Каждого Поле Из РегИзМетаданных.Измерения Цикл
                Сообщить("    " + Поле.Имя + " | " + Поле.Синоним);
            КонецЦикла;

            Сообщить("  Ресурсы:");
            Для Каждого Поле Из РегИзМетаданных.Ресурсы Цикл
                Сообщить("    " + Поле.Имя + " | " + Поле.Синоним);
            КонецЦикла;

            Сообщить("  Реквизиты:");
            Для Каждого Поле Из РегИзМетаданных.Реквизиты Цикл
                Сообщить("    " + Поле.Имя + " | " + Поле.Синоним);
            КонецЦикла;

        КонецЕсли;

    КонецЦикла;

    Если НЕ Найдено Тогда
        Сообщить("Подходящий регистр не найден.");
        Сообщить("Будет выполнен полный список регистров, чтобы найти его вручную:");

        Для Каждого РегИзМетаданных Из Метаданные.РегистрыСведений Цикл
            Сообщить("  " + РегИзМетаданных.Имя + " | " + РегИзМетаданных.Синоним);
        КонецЦикла;
    КонецЕсли;

    Сообщить("");
    Сообщить("=== КОНЕЦ ДИАГНОСТИКИ ===");

КонецПроцедуры
